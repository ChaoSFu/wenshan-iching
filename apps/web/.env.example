# 复制为 apps/web/.env.local 后按需修改。全部留空即可在本地用替身跑通完整流程：
# 内嵌 PGlite 数据库、控制台邮件（验证码打印在终端）、模拟支付页、模拟报告。

APP_URL=http://localhost:3000

# 数据库：留空用内嵌 PGlite（数据在 apps/web/.data/）；生产填 PostgreSQL 连接串
DATABASE_URL=
# inline：在 Web 进程里跑后台任务；off：交给 npm run worker
WORKER_MODE=inline

# 32 字节随机密钥（base64），生产必填：openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# 邮件：console | resend
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=问山 <no-reply@example.com>

# 支付：fake | stripe（Stripe 后台把 webhook 指向 /api/webhooks/payment）
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_AMOUNT_MINOR=990
PRICE_CURRENCY=usd

# 模型：fake | openai
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL_REPORT=gpt-6.2-sol
OPENAI_MODEL_TRIAGE=gpt-6.1-terra
OPENAI_EFFORT_REPORT=low
OPENAI_EFFORT_TRIAGE=low

REFUND_AFTER_HOURS=24
REPORT_RETENTION_DAYS=90
