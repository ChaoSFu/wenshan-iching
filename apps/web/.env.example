# 复制为 apps/web/.env.local 后按需修改。全部留空即可在本地用替身跑通完整流程：
# 内嵌 PGlite 数据库、控制台邮件（验证码打印在终端）、模拟支付页、模拟报告。
#
# 生产环境按能力校验（npm run release:check 逐项列出）：
# - 关闭收款（SALES_ENABLED=false）：只需 DATABASE_URL 与 DATA_ENCRYPTION_KEY，即可提供免费起卦与工单；
#   没配的支付、模型、邮件在用到时返回 503，绝不退回替身。
# - 开放收款：数据库、Stripe（含 webhook 密钥）、OpenAI、Resend（已验证的发件域名）缺一项就拒绝启动。

APP_URL=http://localhost:3000

# normal：按配置使用真实服务或替身；simulation：模拟流程（npm run dev:test 与 worker 集成测试使用）。
# 模拟模式下外部服务一律用替身，忽略 DATABASE_URL 与真实密钥（包括本文件里的），只连测试库；生产禁止。
RUN_MODE=normal
# 模拟模式专用的 PostgreSQL 测试库（库名必须含 test）；不填则用 PGlite 测试目录（默认 .data/pglite-test）
SIMULATION_DATABASE_URL=
# 模拟模式下的模型：fake（默认）| openai。openai 只放开模型一项（用本文件的 OPENAI_API_KEY，会计费），
# 支付仍是模拟支付页、邮件仍打印在终端、只连测试库。npm run dev:test:llm 会带上 SIMULATION_LLM=openai
SIMULATION_LLM=fake

# 数据库：留空用内嵌 PGlite（数据在 apps/web/.data/pglite）；生产填 PostgreSQL 连接串
DATABASE_URL=
# inline：在 Web 进程里跑后台任务；off：交给 npm run worker
WORKER_MODE=inline
# 任务租约：worker 崩溃后，running 任务超过这个时长会被重新认领（毫秒）；长任务会定期续租
JOB_LEASE_MS=600000
WORKER_POLL_MS=1000

# 32 字节随机密钥（base64），生产必填：openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# 邮件：console | resend
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=问山 <no-reply@example.com>

# 支付：fake | stripe（Stripe 后台把 webhook 指向 /api/webhooks/payment；
# 需要的事件：checkout.session.completed / expired、charge.refunded、refund.created / updated / failed、charge.dispute.created）
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_AMOUNT_MINOR=99
PRICE_CURRENCY=usd
# 报价版本：改价格时一并修改。页面拿到的报价标识是"版本:金额:币种"，即使忘了改版本号，
# 改了金额或币种标识也会变，旧页面带着旧标识下单会被要求确认新价格
PRICE_VERSION=price@2026-11
# 收款开关：默认关闭。关闭时页面显示"暂未开放"，下单接口拒绝
SALES_ENABLED=false
# 仅模拟模式：允许未审核内容进入模拟支付流程（必须 RUN_MODE=simulation，生产禁止）
# 推荐直接用 npm run dev:test，它会带上这组测试配置并使用独立的测试库
ALLOW_UNREVIEWED_CONTENT=false

# 模型：fake | openai
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL_REPORT=gpt-6.2-sol
OPENAI_MODEL_TRIAGE=gpt-6.1-terra
OPENAI_EFFORT_REPORT=low
OPENAI_EFFORT_TRIAGE=low
# 追问默认继承报告的模型与推理档位，可单独覆盖（例如用 gpt-6.1-terra 降成本；先跑追问盲测再决定）
OPENAI_MODEL_FOLLOWUP=
OPENAI_EFFORT_FOLLOWUP=
# 真实联调（npm run acceptance）只接受 Stripe 测试模式密钥（sk_test_）；OpenAI 联调与 --live 评测必须显式给预算
# 网络、429、5xx 的重发次数（适配层逐次记录，与校验失败后的业务重试分开统计；SDK 自身不重试）；
# 一笔订单的报告最多调用模型几次（含校验重试与后台重试）
OPENAI_MAX_RETRIES=1
MAX_REPORT_CALLS_PER_ORDER=6

REFUND_AFTER_HOURS=24
REPORT_RETENTION_DAYS=90

# 客服：对用户公开的邮箱（网站故障时的备用联系方式）、新工单通知邮箱、可访问 /ops 后台的登录邮箱
SUPPORT_EMAIL=
SUPPORT_NOTIFY_EMAIL=
OPS_EMAILS=
# 工单"已解决"后保留描述、联系方式与随附问题的天数，之后清除（运营记录里的备注一并清除）
SUPPORT_RETENTION_DAYS=365
