{
  "name": "@wenshan/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run server-content",
    "dev": "next dev",
    "predev:test": "npm run server-content",
    "dev:test": "RUN_MODE=simulation SALES_ENABLED=true ALLOW_UNREVIEWED_CONTENT=true PGLITE_DIR=.data/pglite-test OPS_EMAILS=${OPS_EMAILS:-ops@example.com} next dev",
    "worker:test": "RUN_MODE=simulation SALES_ENABLED=true ALLOW_UNREVIEWED_CONTENT=true PGLITE_DIR=.data/pglite-test tsx scripts/worker.ts",
    "prebuild": "npm run server-content",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "server-content": "tsx scripts/build-server-content.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit -p .",
    "check:services": "tsx scripts/check-services.ts",
    "eval:models": "tsx scripts/eval-models.ts",
    "release:check": "tsx scripts/release-check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@wenshan/content": "*",
    "@wenshan/iching-core": "*",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "openai": "^7.62.0",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.3.5"
  }
}
