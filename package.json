{
  "name": "wenshan-iching",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run dev -w @wenshan/web",
    "dev:test": "npm run dev:test -w @wenshan/web",
    "dev:test:llm": "npm run dev:test:llm -w @wenshan/web",
    "build": "npm run content:build && npm run build -w @wenshan/web",
    "start": "npm run start -w @wenshan/web",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "content:import": "npm run import -w @wenshan/content",
    "content:build": "npm run build -w @wenshan/content",
    "content:check": "npm run check -w @wenshan/content",
    "content:strict": "npm run check:strict -w @wenshan/content",
    "release:check": "npm run release:check -w @wenshan/web --",
    "verify": "tsx scripts/verify.ts"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
